#!/bin/bash

SITEPACK=$(python -c "import sysconfig; print(sysconfig.get_paths()['purelib'])")
PYTHON=$(which python)
DJANGO_SETTINGS="export DJANGO_SETTINGS_MODULE=hrzoosignup.settings"
MANAGEPY=$SITEPACK/hrzoosignup/manage.py

usage()
{
	printf "Usage: %s [argument]\n" $(basename $0) >&2
	printf "       [-c]                                  - create database or apply new migrations\n" >&2
	printf "       [-l]                                  - list migrations\n" >&2
	printf "       [-u]                                  - create superuser\n" >&2
	printf "       [-m]                                  - create new migrations\n" >&2
	printf "       [-d]                                  - load data from file\n" >&2
	printf "       [-p] [-e] -f <filename>               - dump data to a file\n" >&2
	exit 2
}

if [[ $# == 0 ]]
then
    usage
fi

while getopts 'clhumpd:' OPTION
do
    case $OPTION in
        c)
            $DJANGO_SETTINGS && \
            $PYTHON $MANAGEPY migrate
            ;;
        l)
            $DJANGO_SETTINGS && \
            $PYTHON $MANAGEPY showmigrations
            ;;
        u)
            $DJANGO_SETTINGS && \
            $PYTHON $MANAGEPY superuser
             ;;
        m)
            $DJANGO_SETTINGS && \
            $PYTHON $MANAGEPY makemigrations backend
             ;;
        d)
            $DJANGO_SETTINGS && \
            $PYTHON $MANAGEPY loaddata $OPTARG
             ;;

        p)
            while getopts 'f:e' OPTION2
            do
              case $OPTION2 in
               f) filename=$OPTARG ;;
               e) exclude=1 ;;
              esac
            done
           if [[ $exclude == 1 ]]
           then
             $DJANGO_SETTINGS && \
             $PYTHON $MANAGEPY dumpdata --indent 4 --exclude backend.resourceusage > $filename
           else
             $DJANGO_SETTINGS && \
             $PYTHON $MANAGEPY dumpdata --indent 4 > $filename
           fi
           ;;

        h)
            usage
            ;;
        ?)
            usage
            ;;
    esac
done
